{
  "name": "omarkd",
  "productName": "Omarkd",
  "version": "0.1.6",
  "description": "A fast, native Markdown viewer you can launch from the command line.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/contd/omarkd.git"
  },
  "keywords": [
    "tauri",
    "markdown",
    "typescript",
    "rust",
    "ui"
  ],
  "author": {
    "name": "Jason Kumpf",
    "email": "jason.kumpf@apexsupplychain.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:icons": "tauri icon icon.svg",
    "release:check": "bun scripts/check-release.ts",
    "version:sync": "bun scripts/check-release.ts --sync",
    "version": "bun scripts/check-release.ts --sync && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "install:cli": "sh scripts/install-cli.sh",
    "uninstall:cli": "sh scripts/uninstall-cli.sh",
    "docs": "bun run docs:ts && bun run docs:rust && bun run docs:reports",
    "docs:ts": "typedoc",
    "docs:rust": "bun scripts/rust-docs.ts",
    "docs:reports": "bun scripts/test-reports.ts",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run --coverage && bun run test:rust",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "test:screenshots": "OMARKD_SCREENSHOTS=1 playwright test",
    "test:types": "tsc --noEmit -p tsconfig.tests.json",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/language": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "github-markdown-css": "^5.9.0",
    "mermaid": "^12.1.0",
    "temml": "^0.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.0",
    "jsdom": "^26.1.0",
    "typedoc": "^0.28.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
